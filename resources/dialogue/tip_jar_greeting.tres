[sub_resource type="Resource" id="Resource_line1"]
script = ExtResource("2_line")
Speaker = "Aunt Bea"
Text = "Morning, love! I couldn't wait to hear. How did your first day go?"

[sub_resource type="Resource" id="Resource_line2"]
script = ExtResource("2_line")
Speaker = "You"
Text = "Busier than I expected! I think people liked the coffee."

[sub_resource type="Resource" id="Resource_line3"]
script = ExtResource("2_line")
Speaker = "Aunt Bea"
Text = "Of course they did. Now, a proper coffee shop needs one of these. I found it at the back of my cupboard..."

