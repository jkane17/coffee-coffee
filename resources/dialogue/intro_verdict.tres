[sub_resource type="Resource" id="Resource_line1"]
script = ExtResource("2_line")
Speaker = "Aunt Bea"
Text = "Mmm. You know, that's not half bad!"

[sub_resource type="Resource" id="Resource_line2"]
script = ExtResource("2_line")
Speaker = "Aunt Bea"
Text = "People round here would pay for a cup like this. You should turn this place into a coffee shop."

[sub_resource type="Resource" id="Resource_line3"]
script = ExtResource("2_line")
Speaker = "You"
Text = "A coffee shop... Why not? Let's do it!"

[sub_resource type="Resource" id="Resource_line4"]
script = ExtResource("2_line")
Speaker = "Aunt Bea"
Text = "That's the spirit! I'll tell everyone. Good luck tomorrow, love."

